# Copy this file to .env and fill in your own values.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql://username:password@localhost:5432/study_buddy
GROQ_API_KEY=your-groq-api-key
CHROMA_PERSIST_DIR=./chroma_db
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200
FRONTEND_URL=http://127.0.0.1:5500
CORS_ORIGINS=["http://localhost:5173","http://localhost:5500","http://127.0.0.1:5500"]
LLM_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=all-MiniLM-L6-v2
REQUEST_TIMEOUT_SECONDS=30
